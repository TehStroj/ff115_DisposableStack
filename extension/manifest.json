{
  "manifest_version": 2,
  "name": "DisposableStack for Firefox 115",
  "version": "0.1.0",
  "description": "Adds missing JavaScript disposal APIs to ChatGPT. No telemetry or network requests.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ff115-disposable-stack@tehstroj.github.io",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["polyfill.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
