{
  "manifest_version": 2,
  "name": "DisposableStack for Firefox 115",
  "version": "0.1.1",
  "description": "Adds missing JavaScript disposal APIs to ChatGPT. No telemetry or network requests.",
  "author": "TehStroj",
  "homepage_url": "https://github.com/TehStroj/ff115_DisposableStack",
  "browser_specific_settings": {
    "gecko": {
      "id": "ff115-disposable-stack@tehstroj.github.io",
      "strict_min_version": "115.31.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["polyfill.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
